#include <bits/stdc++.h>
using namespace std;

int arr[20];

int main() {
	cin.tie(0)->sync_with_stdio(0);
	int t; cin >> t;
	for (int tc = 1; tc <= t; tc++) {
		int n, limit; cin >> n >> limit;
		for (int i = 0; i < n; i++) cin >> arr[i];

		int ans = INT_MAX;
		for (int i = 1; i < (1 << n); i++) {
			int sum = 0;
			for (int j = 0; j < n; j++) {
				if (i & (1 << j)) sum += arr[j];
			}
			if (sum >= limit) ans = min(ans, sum - limit);
		}
		cout << "#" << tc << " " << ans << "\n";
	}
}